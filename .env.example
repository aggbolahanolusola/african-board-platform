# Copy to `.env` for local development. Values below match docker-compose.yml.
# Never commit a real `.env`.

# --- Database ---
DATABASE_URL=mysql://nurtgov:nurtgov@localhost:3306/nurtgov
# Separate database used by the integration test bed (see TESTBED.md).
TEST_DATABASE_URL=mysql://nurtgov:nurtgov@localhost:3306/nurtgov_test

# --- Auth / session ---
# Must be a long random string (>= 32 chars). Used to sign session JWTs.
JWT_SECRET=dev-only-secret-change-me-please-0123456789abcdef
# App identifier embedded in the session token payload.
VITE_APP_ID=local-dev-app
# Manus OAuth server (only needed for the OAuth login flow).
OAUTH_SERVER_URL=http://localhost:9999
# OpenId that should be auto-granted the global "admin" role (optional).
OWNER_OPEN_ID=

# --- Frontend ---
VITE_FRONTEND_URL=http://localhost:5173

# --- Stripe (optional; billing flows) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Storage (optional; S3 document uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
